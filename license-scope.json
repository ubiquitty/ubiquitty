{
  "version": 1,
  "description": "Every repository file has a checked header or exactly one explicit scope. The boundary assigns each first-party path its license: an exact file beats a pattern, and a pattern beats the longest directory prefix ('./' is the repository's top-level files). Rules record files that cannot carry a header and upstream material; a header or metadata rule must agree with its file's boundary license. Upstream notices remain intact. Review entries block release checks.",
  "boundary": [
    {
      "license": "Apache-2.0",
      "paths": [
        "./",
        ".github/",
        "ci_scripts/",
        "cmake/",
        "Docs/",
        "Resources/",
        "Samples/",
        "Scripts/",
        "Source/",
        "Support/",
        "Tests/",
        "Tools/",
        "Ubiquitty.xcworkspace/",
        "UbiquittyIOS.xcworkspace/"
      ],
      "reason": "Every original file in the repository: the terminal engine, the platform backends, the renderers, the application shells, the host daemon, the agent, the editor clients, the documentation, the tests and the tooling. The product's commercial side is an operated service that is not in this repository, so nothing here needs a narrower license."
    },
    {
      "license": "CC-BY-4.0",
      "paths": [
        ".github/code_of_conduct.md"
      ],
      "reason": "Adaptation of Contributor Covenant 2.1, which keeps its upstream license."
    },
    {
      "license": "MIT",
      "paths": [
        "Source/Platform/Emacs/"
      ],
      "reason": "Emacs Sync client, which keeps its separate MIT license."
    }
  ],
