                      ubiquitty-sync--kind-image-placements ubiquitty-sync--kind-sample-head ubiquitty-sync--kind-image-want) '(50 52 53 54 75)))
  (let ((body (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1))))
    (dotimes (size (length body))
      (unless (= size 18) (should-error (ubiquitty-sync--read-effect (substring body 0 size)))))
    (should-error (ubiquitty-sync--read-effect (concat body "x"))))
  (dolist (body (list (ubiquitty-effect-test--packet 0 0)
                     (ubiquitty-effect-test--packet 1 256 (ubiquitty-effect-test--record 1))
                     (ubiquitty-effect-test--packet 1 1 (ubiquitty-effect-test--record 1))
                     (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 0))
                     (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1 0 "" 3))
                     (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1 5))
                     (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1 99))))
    (should-error (ubiquitty-sync--read-effect body)))
  (let ((body (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1 1 (unibyte-string 1 ?T 1 ?B 1 ?I 0)))))
    (should (equal (plist-get (plist-get (ubiquitty-sync--read-effect body) :record) :title) "T")))
  (dolist (invalid (list (unibyte-string 1 255 0 0 0) (unibyte-string 2 #xc0 #x80 0 0 0)
                        (unibyte-string 3 #xed #xa0 #x80 0 0 0) (unibyte-string 1 #xc2 0 0 0)
                        (unibyte-string 128 0 0 0 0) (unibyte-string 0 0 0 3)))
    (should-error (ubiquitty-sync--read-effect (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1 1 invalid))))))

