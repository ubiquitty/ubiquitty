(ert-deftest ubiquitty-effect-receipt-resume-and-bounds ()
  (let ((cursor (ubiquitty-sync--effect-cursor)))
    (should-error (ubiquitty-sync--accept-effect cursor (ubiquitty-sync--read-effect
                                                       (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1))) nil))
    (should (ubiquitty-sync--accept-effect cursor (ubiquitty-sync--read-effect
                                                 (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1 0 "" 0) 0)) nil)))
  (let* ((cursor (ubiquitty-sync--effect-cursor))
         (first (ubiquitty-sync--read-effect (ubiquitty-effect-test--packet 3 1 (ubiquitty-effect-test--record 1))))
         (last (ubiquitty-sync--read-effect (ubiquitty-effect-test--packet 3 0 (ubiquitty-effect-test--record 3)))))
    (should-error (ubiquitty-sync--accept-effect cursor first 1))
    (should (equal cursor [0 0 nil nil nil nil]))
    (should (ubiquitty-sync--accept-effect cursor first 2))
    (should (= (aref cursor 0) 0))
    (let ((saved (copy-sequence cursor)))
      (should-error (ubiquitty-sync--accept-effect cursor (ubiquitty-sync--read-effect (ubiquitty-effect-test--packet 3 0)) 2))
      (should (equal cursor saved)))
    (setq cursor (ubiquitty-sync--effect-cursor (cons (aref cursor 0) (aref cursor 1))))
    (should-not (ubiquitty-sync--accept-effect cursor first 2))
    (should (ubiquitty-sync--accept-effect cursor last 2))
    (should (= (aref cursor 0) 3))
    (should-not (ubiquitty-sync--accept-effect cursor last 2))
    (should-error (ubiquitty-sync--accept-effect cursor (ubiquitty-sync--read-effect (ubiquitty-effect-test--packet 2 0)) 2)))
  (should-error (ubiquitty-sync--effect-cursor '(4 . 3)))
  (let ((cursor (ubiquitty-sync--effect-cursor)) (huge (expt 2 53)))
    (should (ubiquitty-sync--accept-effect cursor (ubiquitty-sync--read-effect
                                                 (ubiquitty-effect-test--packet (1+ huge) 1 (ubiquitty-effect-test--record huge))) 2))
    (should (ubiquitty-sync--accept-effect cursor (ubiquitty-sync--read-effect
                                                 (ubiquitty-effect-test--packet (1+ huge) 0 (ubiquitty-effect-test--record (1+ huge)))) 2)))
  (let ((cursor (ubiquitty-sync--effect-cursor)))
    (dotimes (index 256)
      (should (ubiquitty-sync--accept-effect cursor (ubiquitty-sync--read-effect
                                                   (ubiquitty-effect-test--packet 256 (- 255 index) (ubiquitty-effect-test--record (1+ index)))) 2)))
    (should (= (aref cursor 0) 256))))

(ert-deftest ubiquitty-effect-real-dispatch-primary-and-unbind ()
  (with-temp-buffer
    (ubiquitty-wire-fixture--admit)
    (let ((posts 0) (sent nil) (pane (make-string 16 ?n)))
      (setq ubiquitty-sync--client-instance (make-string 16 ?p) ubiquitty-sync--welcome (ubiquitty-sync--read-welcome (ubiquitty-wire-fixture--welcome)))
      (cl-letf (((symbol-function 'ubiquitty-sync--send-sync) (lambda (&rest values) (push values sent)))
                ((symbol-function 'ubiquitty-sync--send-viewport) #'ignore)
                ((symbol-function 'ding) (lambda (&rest _) (cl-incf posts))))
        (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-bind 0 (concat (unibyte-string 1) pane))
        (setq ubiquitty-sync--generation 2)
        (dotimes (_ 2)
          (ubiquitty-effect-test--receive ubiquitty-sync--kind-effect 1 (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1))))
        (should (= posts 1))
        (should (= (length ubiquitty-sync--effects) 1))
        (should (= (aref ubiquitty-sync--effect-cursor 0) 1))
        (should-error (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-unbind 0 (unibyte-string 2 0)))
        (should (equal ubiquitty-sync--effect-pane pane))
        (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-bind 0 (concat (unibyte-string 2) pane))
        (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-unbind 0 (unibyte-string 2 0))
        (should (equal ubiquitty-sync--effect-pane pane))
        (should (= ubiquitty-sync--pane 1))
        (ubiquitty-effect-test--receive ubiquitty-sync--kind-effect 1 (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1)))
        (should (= posts 1))
        (setq ubiquitty-sync--client-instance (make-string 16 ?s))
        (ubiquitty-effect-test--receive ubiquitty-sync--kind-effect 1 (ubiquitty-effect-test--packet 2 0 (ubiquitty-effect-test--record 2)))
        (should (= posts 1))
        (should (eq (plist-get (car ubiquitty-sync--effects) :disposition) 'badge))
        (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-unbind 0 (unibyte-string 1 0))
        (should-not ubiquitty-sync--effect-cursor)
        (should-not ubiquitty-sync--effect-pane)))))

(ert-deftest ubiquitty-effect-alias-batches-interleave-without-reposting ()
  (with-temp-buffer
    (ubiquitty-wire-fixture--admit)
    (let ((pane (make-string 16 ?n)) (answers nil))
      (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
                ((symbol-function 'ubiquitty-sync--send-sync)
                 (lambda (_ kind _channel body) (when (= kind ubiquitty-sync--kind-ack) (push body answers))))
                ((symbol-function 'ubiquitty-sync--send-viewport) #'ignore))
        (dolist (handle '(1 2))
          (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-bind 0 (concat (unibyte-string handle) pane)))
        (setq ubiquitty-sync--generation 2)
        (dolist (handle '(1 2))
          (ubiquitty-effect-test--receive 50 handle (ubiquitty-effect-test--packet 2 1 (ubiquitty-effect-test--record 1))))
        (ubiquitty-effect-test--receive 50 1 (ubiquitty-effect-test--packet 2 0 (ubiquitty-effect-test--record 2)))
        (ubiquitty-sync--send-owed-ack nil (current-buffer))
        (should (equal (substring (car answers) 20)
                       (concat (unibyte-string 1 1) (ubiquitty-sync--put-u64 2) (ubiquitty-sync--put-u64 0) (ubiquitty-sync--put-u64 2))))
        (should (= (length ubiquitty-sync--effects) 2))
        (ubiquitty-effect-test--receive 50 2 (ubiquitty-effect-test--packet 2 0 (ubiquitty-effect-test--record 2)))
        (ubiquitty-sync--send-owed-ack nil (current-buffer))
        (should (equal (substring (car answers) 20)
                       (concat (unibyte-string 1 2) (ubiquitty-sync--put-u64 2) (ubiquitty-sync--put-u64 0) (ubiquitty-sync--put-u64 2))))
        (should (= (length ubiquitty-sync--effects) 2))
        (dolist (handle '(1 2))
          (ubiquitty-effect-test--receive 50 handle (ubiquitty-effect-test--packet 4 1 (ubiquitty-effect-test--record 3))))
        (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-unbind 0 (unibyte-string 1 0))
        (ubiquitty-effect-test--receive 50 2 (ubiquitty-effect-test--packet 4 0 (ubiquitty-effect-test--record 4)))
        (should (= (length ubiquitty-sync--effects) 4))))))

(ert-deftest ubiquitty-effect-invalid-frame-stops-carrier ()
  (with-temp-buffer
    (ubiquitty-wire-fixture--admit)
    (let ((proc (make-pipe-process :name "ubiquitty-effect-fixture" :buffer (current-buffer) :noquery t))
          (posted 0))
      (unwind-protect
          (progn
            (process-put proc 'buffer (current-buffer))
            (setq ubiquitty-sync--pane 1 ubiquitty-sync--effect-pane (make-string 16 ?n)
                  ubiquitty-sync--effect-cursor (ubiquitty-sync--effect-cursor) ubiquitty-sync--generation 2)
            (cl-labels ((frame (body)
                          (concat (unibyte-string 50 1) (ubiquitty-sync--put-varint (length body)) body)))
              (cl-letf (((symbol-function 'ubiquitty-sync--present-effect) (lambda (_) (cl-incf posted))))
                (ubiquitty-sync--filter proc (concat (frame (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1 99)))
                                                    (frame (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1)))))))
            (should-not (process-live-p proc))
            (should (process-get proc 'protocol-failure))
            (ubiquitty-sync--filter proc "ignored after refusal")
            (should (= posted 0))
            (should (= (aref ubiquitty-sync--effect-cursor 0) 0)))
        (when (process-live-p proc) (delete-process proc))))))

(ert-deftest ubiquitty-effect-bindings-are-bounded-and-one-pane ()
  (dolist (failure '(distinct duplicate capacity listing))
    (with-temp-buffer
    (ubiquitty-wire-fixture--admit)
      (cl-letf (((symbol-function 'ubiquitty-sync--send-sync) #'ignore)
                ((symbol-function 'ubiquitty-sync--send-viewport) #'ignore))
        (let ((pane (make-string 16 ?n)))
          (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-bind 0 (concat (unibyte-string 1) pane))
          (aset ubiquitty-sync--effect-cursor 1 9)
          (when (eq failure 'capacity)
            (cl-loop for handle from 2 to ubiquitty-sync--max-panes-per-connection do
                     (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-bind 0 (concat (ubiquitty-sync--put-varint handle) pane)))
            (should (= (length ubiquitty-sync--pane-bindings) ubiquitty-sync--max-panes-per-connection)))
          (should-error (ubiquitty-effect-test--receive
                         ubiquitty-sync--kind-pane-bind 0 (cond ((eq failure 'distinct) (concat (unibyte-string 2) (make-string 16 ?x)))
                                    ((eq failure 'duplicate) (concat (unibyte-string 1) pane))
                                    ((eq failure 'listing) (concat (ubiquitty-sync--put-varint ubiquitty-sync--first-listed-handle) pane))
                                    (t (concat (ubiquitty-sync--put-varint (1+ ubiquitty-sync--max-panes-per-connection)) pane)))))
          (should (= (aref ubiquitty-sync--effect-cursor 1) 9)))))))

(ert-deftest ubiquitty-effect-ack-is-final-only ()
  (with-temp-buffer
    (ubiquitty-wire-fixture--admit)
    (setq ubiquitty-sync--pane 1 ubiquitty-sync--effect-pane (make-string 16 ?n)
          ubiquitty-sync--effect-cursor (ubiquitty-sync--effect-cursor)
          ubiquitty-sync--effect-cursors (list (cons 1 (ubiquitty-sync--effect-cursor))) ubiquitty-sync--generation 2)
    (let ((answers nil))
      (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
                ((symbol-function 'ubiquitty-sync--send-sync) (lambda (_ kind _channel body) (when (= kind ubiquitty-sync--kind-ack) (push body answers)))))
        (ubiquitty-effect-test--receive 50 1 (ubiquitty-effect-test--packet 3 1 (ubiquitty-effect-test--record 1)))
        (ubiquitty-sync--send-owed-ack nil (current-buffer))
        (should (= (aref (car answers) 20) 0)) ; bytes ACK, no completed pane batch
        (ubiquitty-effect-test--receive 50 1 (ubiquitty-effect-test--packet 3 0 (ubiquitty-effect-test--record 3)))
        (ubiquitty-sync--send-owed-ack nil (current-buffer))
        (let ((ack (ubiquitty-sync--reader (car answers) 20)))
          (should (= (ubiquitty-sync--r-varint ack) 1))
          (should (= (ubiquitty-sync--r-varint ack) 1))
          (should (= (ubiquitty-sync--r-u64 ack) 2))
          (should (= (ubiquitty-sync--r-u64 ack) 0))
          (should (= (ubiquitty-sync--r-u64 ack) 3))
          (should (ubiquitty-sync--r-end-p ack)))))))

(ert-deftest ubiquitty-image-sha-owner-and-missing-only-wants ()
  (with-temp-buffer
    (ubiquitty-wire-fixture--admit)
    (ubiquitty-sync--reset-image-connection)
    (setq ubiquitty-sync--pane 1)
    (let* ((pixels (unibyte-string 255 0 0 127 0 255 0 255 0 0 255 0 255 255 255 255))
           (hash (unibyte-string #xd5 #xe7 #x34 #x7a #x4b #x32 #x1d #xf4 #x39 #x17 #xc8 #x6a #x75 #xdc #x22 #x32))
           (asset (concat hash (unibyte-string 32) (ubiquitty-sync--put-u32 2) (ubiquitty-sync--put-u32 2)))
           (wants 0))
      (cl-letf (((symbol-function 'ubiquitty-sync--send-sync) (lambda (_ kind _channel _body) (when (= kind 75) (cl-incf wants)))))
        (cl-labels ((state (revision id)
                      (ubiquitty-effect-test--receive 53 1 (concat (ubiquitty-sync--put-u32 revision)
                                                                 (if id (concat (unibyte-string 1) (ubiquitty-sync--put-u32 id)
                                                                                (make-string 4 0) asset (make-string 9 0)) (unibyte-string 0))
                                                                 (unibyte-string 0))))
                    (head (transfer) (ubiquitty-effect-test--receive 52 1 (concat asset (ubiquitty-sync--put-u32 transfer))))
                    (chunk (transfer index final bytes &optional bad)
                      (ubiquitty-effect-test--receive ubiquitty-sync--kind-bulk-chunk 0
                                                     (concat (ubiquitty-sync--put-u32 transfer) (ubiquitty-sync--put-u32 index)
                                                             (unibyte-string (if final 1 0)) (ubiquitty-sync--put-bytes bytes)
                                                             (if final (if bad (make-string 32 0) (secure-hash 'sha256 pixels nil nil t)) "")))))
          (state 1 7)
          (head 0) (head 0)
          (should (= wants 1))
          (head 100)
          (should (equal (ubiquitty-sync--image-owned-bytes) '(41 . 16)))
          (chunk 100 0 nil (substring pixels 0 8))
          (should-not (gethash 7 ubiquitty-sync--images))
          (chunk 100 1 t (substring pixels 8))
          (let ((owner (nth 3 (gethash 7 ubiquitty-sync--images))))
            (should (equal (substring owner 25) pixels))
            (state 2 9) (head 0)
            (should (= wants 1))
            (should (eq owner (nth 3 (gethash 9 ubiquitty-sync--images)))))
          (state 3 nil) (state 4 7) (head 101)
          (should-error (chunk 101 0 t pixels t))
          (should (= (hash-table-count ubiquitty-sync--image-cache) 0))
          (should (= (car (ubiquitty-sync--image-owned-bytes)) 0))
          (head 102)
          (ubiquitty-effect-test--receive ubiquitty-sync--kind-bulk-abort 0 (ubiquitty-sync--put-u32 102))
          (ubiquitty-sync--request-missing-images nil)
          (should (= wants 1))
          (head 0)
          (should (= wants 2)))))))

(defconst ubiquitty-sample-test--pcm (unibyte-string 0 128 255 255 0 0 255 127))
(defconst ubiquitty-sample-test--digest
  (apply #'unibyte-string '(#xa0 #xb3 #xd8 #xf5 #xdb #xcd #xc6 #xda #xc3 #x37 #xb3 #xde #x2e #x92 #xfe #x62
                           #xe1 #x39 #x1e #x6a #x03 #x1d #x57 #x7c #xa3 #xf7 #xb4 #xb8 #x04 #xac #x9c #x79)))
(defun ubiquitty-sample-test--identity (&optional bad)
  (concat (ubiquitty-sync--put-u32 7) (ubiquitty-sync--put-u32 4)
          (if bad (make-string 32 ?x) ubiquitty-sample-test--digest)))
(defun ubiquitty-sample-test--sound (&optional bad)
  (let ((request (make-string 29 0)))
    (aset request 1 6) (aset request 16 1)
    (concat request (ubiquitty-sample-test--identity bad))))

(ert-deftest ubiquitty-sample-codec-exact-boundary ()
  (let ((head (concat (unibyte-string 1) (ubiquitty-sample-test--identity) (ubiquitty-sync--put-u32 501))))
    (should (= (length head) 45))
    (dotimes (size 45) (should-error (ubiquitty-sync--read-sample-head (substring head 0 size))))
    (dolist (bad (list (concat head "x") (concat (unibyte-string 0) (substring head 1))
                       (concat (unibyte-string 26) (substring head 1))
                       (concat (substring head 0 5) (ubiquitty-sync--put-u32 441001) (substring head 9))
                       (concat (substring head 0 41) (make-string 4 0))))
      (should-error (ubiquitty-sync--read-sample-head bad)))
    (should (= (plist-get (plist-get (ubiquitty-sync--read-sample-head head) :identity) :frames) 4)))
  (should (equal (secure-hash 'sha256 ubiquitty-sample-test--pcm nil nil t) ubiquitty-sample-test--digest))
  (should (= (plist-get (plist-get (plist-get (plist-get (ubiquitty-sync--read-effect
          (ubiquitty-effect-test--packet 1 0 (ubiquitty-effect-test--record 1 3 (ubiquitty-sample-test--sound))))
          :record) :sound) :identity) :serial) 7)))

(ert-deftest ubiquitty-sample-order-digest-and-retirement ()
  (dolist (mode '(complete hash head-hash unbind cap overwrite))
    (with-temp-buffer
    (ubiquitty-wire-fixture--admit)
      (cl-letf (((symbol-function 'ubiquitty-sync--send-sync) #'ignore)
                ((symbol-function 'ubiquitty-sync--send-viewport) #'ignore)
                ((symbol-function 'ding) #'ignore))
        (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-bind 0 (concat (unibyte-string 1) (make-string 16 ?n)))
        (setq ubiquitty-sync--generation 2 ubiquitty-sync--client-instance (make-string 16 ?p)
              ubiquitty-sync--welcome (ubiquitty-sync--read-welcome (ubiquitty-wire-fixture--welcome)))
        (ubiquitty-effect-test--receive 54 1 (concat (unibyte-string 1) (ubiquitty-sample-test--identity (eq mode 'head-hash))
                                                   (ubiquitty-sync--put-u32 501)))
        (ubiquitty-effect-test--receive 50 1 (ubiquitty-effect-test--packet 1 0
             (ubiquitty-effect-test--record 1 3 (ubiquitty-sample-test--sound (eq mode 'head-hash)))))
        (should (= (aref ubiquitty-sync--effect-cursor 1) 0))
        (should (= (length ubiquitty-sync--deferred-effects) 1))
        (should (= (car (ubiquitty-sync--image-owned-bytes)) (+ 8 ubiquitty-sync--deferred-effect-bytes)))
        (cond
         ((eq mode 'unbind)
          (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-unbind 0 (unibyte-string 1 0))
          (should (= (hash-table-count ubiquitty-sync--sample-transfers) 0))
          (should (= ubiquitty-sync--deferred-effect-bytes 0)))
         ((eq mode 'cap)
          (cl-loop for sequence from 2 to 256 do
                   (ubiquitty-effect-test--receive 50 1 (ubiquitty-effect-test--packet sequence 0 (ubiquitty-effect-test--record sequence))))
          (should-error (ubiquitty-effect-test--receive 50 1 (ubiquitty-effect-test--packet 257 0 (ubiquitty-effect-test--record 257))))
          (should (= (length ubiquitty-sync--deferred-effects) 256))
          (should (= (aref ubiquitty-sync--effect-cursor 1) 0)))
         ((eq mode 'overwrite)
          (should-error (ubiquitty-effect-test--receive 54 1 (concat (unibyte-string 1) (ubiquitty-sample-test--identity)
                                                                  (ubiquitty-sync--put-u32 502)))))
         (t
          (ubiquitty-effect-test--receive 50 1 (ubiquitty-effect-test--packet 2 0 (ubiquitty-effect-test--record 2)))
          (should-not ubiquitty-sync--effects)
          (ubiquitty-sync--take-sample-chunk 501 0 0 (substring ubiquitty-sample-test--pcm 0 3) nil)
          (should (= (aref (gethash 501 ubiquitty-sync--sample-transfers) 4) 3))
          (if (eq mode 'complete)
              (progn
                (ubiquitty-sync--take-sample-chunk 501 1 1 (substring ubiquitty-sample-test--pcm 3) ubiquitty-sample-test--digest)
                (should (= (aref ubiquitty-sync--effect-cursor 0) 2))
                (should (= (length ubiquitty-sync--effects) 2))
                (should-not (aref (gethash '(1 . 1) ubiquitty-sync--sample-slots) 3))
                (should (= (car (ubiquitty-sync--image-owned-bytes)) 0)))
            (should-error (ubiquitty-sync--take-sample-chunk 501 1 1 (substring ubiquitty-sample-test--pcm 3)
                             (if (eq mode 'hash) (make-string 32 ?x) ubiquitty-sample-test--digest)))
            (should (= (aref ubiquitty-sync--effect-cursor 1) 0))
            (should-not ubiquitty-sync--effects))))))))

(ert-deftest ubiquitty-sample-aliases-have-independent-transfer-slots ()
  (with-temp-buffer
    (ubiquitty-wire-fixture--admit)
    (cl-letf (((symbol-function 'ubiquitty-sync--send-sync) #'ignore)
              ((symbol-function 'ubiquitty-sync--send-viewport) #'ignore))
      (cl-loop for handle from 1 to 26 do
               (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-bind 0
                   (concat (ubiquitty-sync--put-varint handle) (make-string 16 ?n)))
               (ubiquitty-effect-test--receive 54 handle
                   (concat (unibyte-string 1) (ubiquitty-sample-test--identity) (ubiquitty-sync--put-u32 (+ 600 handle)))))
      (should (= (hash-table-count ubiquitty-sync--sample-transfers) 26))
      (should (= (car (ubiquitty-sync--image-owned-bytes)) (* 26 8)))
      (cl-loop for handle from 1 to 26 do
               (ubiquitty-effect-test--receive ubiquitty-sync--kind-pane-unbind 0
                   (concat (ubiquitty-sync--put-varint handle) (unibyte-string 0))))
      (should (= (hash-table-count ubiquitty-sync--sample-transfers) 0))
      (should (= (hash-table-count ubiquitty-sync--sample-slots) 0)))))

(ert-run-tests-batch-and-exit (car command-line-args-left))
