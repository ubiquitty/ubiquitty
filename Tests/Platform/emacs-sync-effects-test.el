(require 'ubiquitty-sync)
(load (expand-file-name "editor-wire-fixture.el" (file-name-directory load-file-name)) nil t)

(defun ubiquitty-effect-test--record (sequence &optional kind payload generation count)
  (concat (ubiquitty-sync--put-u64 (or generation 2)) (ubiquitty-sync--put-u64 sequence)
          (make-string 16 ?p) (unibyte-string (or kind 0)) (ubiquitty-sync--put-u32 (or count 1)) (or payload "")))
(defun ubiquitty-effect-test--packet (through remaining &optional record generation)
  (concat (ubiquitty-sync--put-u64 (or generation 2)) (ubiquitty-sync--put-u64 through)
          (ubiquitty-sync--put-u16 remaining) (or record "")))
(defun ubiquitty-effect-test--receive (kind channel body &optional process)
  (ubiquitty-sync--receive-sync process (current-buffer)
                               (concat (unibyte-string kind) (ubiquitty-sync--put-varint channel)
                                       (ubiquitty-sync--put-varint (length body)) body)))

(defmacro ubiquitty-wire-test--with-carrier (&rest body)
  "Run BODY with an in-memory process seam and the actual streaming filter."
  (declare (indent 0))
  `(with-temp-buffer
     (let ((proc 'memory-carrier) (properties (make-hash-table :test #'eq)) (closed nil) (closed-processes nil))
       (cl-letf (((symbol-function 'process-get) (lambda (process name) (plist-get (gethash process properties) name)))
                 ((symbol-function 'process-put) (lambda (process name value)
                                                   (puthash process (plist-put (gethash process properties) name value) properties)))
                 ((symbol-function 'process-live-p) (lambda (process) (not (memq process closed-processes))))
                 ((symbol-function 'delete-process) (lambda (process)
                                                      (push process closed-processes)
                                                      (when (eq process proc) (setq closed t))))
                 ((symbol-function 'ubiquitty-sync--close-batch) #'ignore)
                 ((symbol-function 'process-send-string) #'ignore)
                 ((symbol-function 'ubiquitty-sync--send-owed-ack) #'ignore))
         (process-put proc 'buffer (current-buffer))
         (setq ubiquitty-sync--process proc)
         ,@body))))

(ert-deftest ubiquitty-effect-retired-catalog-carriers-fail-before-dispatch ()
  ;; Literal obsolete outer tags are data, never optional generated aliases.
  (dolist (tag '(#x09 #x8b #x0a #x0b #x8c #x8d #x8e #x90 #x91 #x12 #x9b #x17 #x1c #x9e #xa5
                 #x1b #xa3 #xa4 #x83 #x84 #x87 #x88 #x8f #x98 #x99 #x13 #x19 #x9d #xa2
                 #x9f #xa0 #xa6 #xa7 #x89 #x8a #x9a #x0e #x23))
    (ubiquitty-wire-test--with-carrier
      (setq header-line-format "kept title")
      (ubiquitty-sync--filter proc (concat (unibyte-string tag) (ubiquitty-sync--put-u32 1048576)))
      (should closed)
      (should (process-get proc 'protocol-failure))
      (should (equal (process-get proc 'accum) ""))
      (should (equal header-line-format "kept title")))))

(ert-deftest ubiquitty-record-removed-header-latches-refusal-without-a-body ()
  (dolist (bytes (list (unibyte-string #xff) (unibyte-string #x23)
                       (unibyte-string ubiquitty-sync--kind-welcome 1)
                       (unibyte-string ubiquitty-sync--kind-welcome #x80 0)
                       (unibyte-string ubiquitty-sync--kind-welcome 0 #x80 #x80 4)))
    (ubiquitty-wire-test--with-carrier
      (ubiquitty-sync--filter proc bytes)
      (should closed)
      (let ((failure (process-get proc 'protocol-failure)))
        (should failure)
        (ubiquitty-sync--filter proc "untrusted suffix")
        (should (equal failure (process-get proc 'protocol-failure)))
        (should (equal (process-get proc 'accum) ""))))))

(ert-deftest ubiquitty-record-removed-catalog-fragments-cannot-dispatch ()
  ;; No nested grammar remains: the first obsolete Catalog byte is enough.
  (ubiquitty-wire-test--with-carrier
    (ubiquitty-sync--filter proc (unibyte-string #x23))
    (should closed)
    (ubiquitty-sync--filter proc (unibyte-string 1 0 9 #x83 0 0 0 0))
    (should (equal (process-get proc 'accum) ""))
    (should-not ubiquitty-sync--welcome)))

(ert-deftest ubiquitty-record-direct-fragments-dispatch-only-when-whole ()
  (let* ((body (ubiquitty-wire-fixture--welcome))
         (frame (concat (unibyte-string ubiquitty-sync--kind-welcome 0)
                        (ubiquitty-sync--put-bytes body))))
    (dotimes (split (1+ (length frame)))
      (ubiquitty-wire-test--with-carrier
        (setq ubiquitty-sync--admission-request (ubiquitty-wire-fixture--request))
        (ubiquitty-sync--filter proc (substring frame 0 split))
        (unless (= split (length frame)) (should-not ubiquitty-sync--welcome))
        (ubiquitty-sync--filter proc (substring frame split))
        (should-not closed)
        (should (= (plist-get ubiquitty-sync--welcome :session-id) 9))
        (should (equal (process-get proc 'accum) ""))))))

(ert-deftest ubiquitty-record-partial-body-has-one-exact-owner-after-header-admission ()
  (with-temp-buffer
    (let* ((body (make-string ubiquitty-sync--max-frame-body 0))
           (header (concat (unibyte-string ubiquitty-sync--kind-welcome 0)
                           (ubiquitty-sync--put-varint (length body))))
           (frame (concat header body)) (pending "") (owner nil) (allocations 0) (deliveries 0)
           (original (symbol-function 'make-string)))
      (cl-letf (((symbol-function 'make-string)
                 (lambda (size value &optional multibyte)
                   (when (= size (length frame)) (cl-incf allocations))
                   (funcall original size value multibyte))))
        (dotimes (at (length frame))
          (setq pending (ubiquitty-sync--feed-envelopes
                         pending (substring frame at (1+ at))
                         (lambda (received) (cl-incf deliveries) (should (equal received frame)))))
          (if (< at (1- (length header)))
              (should (= allocations 0))
            (should (= allocations 1))
            (unless (= at (1- (length frame)))
              (let ((held (ubiquitty-sync--envelope-state-owner pending)))
                (if owner (should (eq held owner)) (setq owner held))
                (should (= (length held) (length frame)))
                (should (<= (length (ubiquitty-sync--envelope-state-header pending)) ubiquitty-sync--max-envelope-header))))))
        (should (= deliveries 1))
        (should (equal pending ""))))))

(ert-deftest ubiquitty-record-invalid-header-and-multibyte-input-never-allocate-an-owner ()
  (dolist (data (list (unibyte-string #x23) (unibyte-string ubiquitty-sync--kind-welcome 1)
                      (unibyte-string ubiquitty-sync--kind-welcome 0 #x80 #x80 4)
                      (string-as-multibyte "ASCII is still multibyte")))
    (with-temp-buffer
      (let ((allocations 0) (original (symbol-function 'make-string)))
        (cl-letf (((symbol-function 'make-string)
                   (lambda (&rest arguments) (cl-incf allocations) (apply original arguments))))
          (should-error (ubiquitty-sync--feed-envelopes "" data #'ignore)))
        (should (= allocations 0))))))

(ert-deftest ubiquitty-record-same-carrier-recursive-feed-refuses-without-applying-tail ()
  (ubiquitty-wire-test--with-carrier
    (let ((deliveries 0) (frame (concat (unibyte-string ubiquitty-sync--kind-welcome 0) (ubiquitty-sync--put-bytes ""))))
      (cl-letf (((symbol-function 'ubiquitty-sync--receive-sync)
                 (lambda (&rest _)
                   (cl-incf deliveries)
                   (ubiquitty-sync--filter proc frame))))
        (ubiquitty-sync--filter proc (concat frame frame)))
      (should (= deliveries 1))
      (should closed)
      (should (equal (process-get proc 'protocol-failure) "ubiquitty-sync: recursive transport feed"))
      (should (equal (process-get proc 'accum) ""))
      (should-not (process-get proc 'feeding)))))

(ert-deftest ubiquitty-record-replaced-owner-keeps-new-reader-and-drops-old-tail ()
  (ubiquitty-wire-test--with-carrier
    (let ((deliveries 0) (new 'replacement-carrier) (sentinel (list 'new-owner))
          (frame (concat (unibyte-string ubiquitty-sync--kind-welcome 0) (ubiquitty-sync--put-bytes ""))))
      (cl-letf (((symbol-function 'ubiquitty-sync--receive-sync)
                 (lambda (&rest _)
                   (cl-incf deliveries)
                   (setq ubiquitty-sync--process new)
                   (cl-incf ubiquitty-sync--connection-generation)
                   (process-put new 'buffer (current-buffer))
                   (process-put new 'accum sentinel))))
        (ubiquitty-sync--filter proc (concat frame frame)))
      (should (= deliveries 1))
      (should (eq (process-get new 'accum) sentinel))
      (should-not (process-get new 'protocol-failure))
      (should-not (process-get proc 'feeding))
      (should-not closed))))

