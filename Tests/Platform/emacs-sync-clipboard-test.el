(require 'ert)
(add-to-list 'load-path (expand-file-name "../../Source/Platform/Emacs" (file-name-directory load-file-name)))
(require 'ubiquitty-sync)
(load (expand-file-name "editor-wire-fixture.el" (file-name-directory load-file-name)) nil t)

(defun ubiquitty-clipboard-test--bundle (items)
  (concat (ubiquitty-sync--put-varint (length items))
          (mapconcat (lambda (item) (concat (ubiquitty-sync--put-bytes (encode-coding-string (car item) 'utf-8))
                                            (ubiquitty-sync--put-bytes (cdr item)))) items "")))
(defun ubiquitty-clipboard-test--packet (sequence selector bundle &optional transfer primary)
  (concat (ubiquitty-sync--put-u64 2) (ubiquitty-sync--put-u64 sequence) (ubiquitty-sync--put-u16 0)
          (ubiquitty-sync--put-u64 2) (ubiquitty-sync--put-u64 sequence) (or primary (make-string 16 ?p))
          (unibyte-string 5) (ubiquitty-sync--put-u32 1) (unibyte-string selector)
          (ubiquitty-sync--put-u32 (or transfer 0)) (ubiquitty-sync--put-u32 (length bundle))
          (if transfer "" bundle)))
(defun ubiquitty-clipboard-test--receive (kind handle body)
  (ubiquitty-sync--receive-sync nil (current-buffer)
      (concat (unibyte-string kind) (ubiquitty-sync--put-varint handle) (ubiquitty-sync--put-varint (length body)) body)))
(defun ubiquitty-clipboard-test--chunk (transfer index final bytes &optional digest)
  (ubiquitty-clipboard-test--receive ubiquitty-sync--kind-bulk-chunk 0
      (concat (ubiquitty-sync--put-u32 transfer) (ubiquitty-sync--put-u32 index)
              (unibyte-string (if final 1 0)) (ubiquitty-sync--put-bytes bytes) (if final digest ""))))
(defmacro ubiquitty-clipboard-test--with-client (&rest body)
  (declare (indent 0))
  `(with-temp-buffer
     (ubiquitty-wire-fixture--admit)
     (cl-letf (((symbol-function 'ubiquitty-sync--send-sync) #'ignore)
               ((symbol-function 'ubiquitty-sync--send-viewport) #'ignore))
       (ubiquitty-clipboard-test--receive ubiquitty-sync--kind-pane-bind 0 (concat (unibyte-string 1) (make-string 16 ?n)))
       (setq ubiquitty-sync--generation 2 ubiquitty-sync--client-instance (make-string 16 ?p)
             ubiquitty-sync--welcome (ubiquitty-sync--read-welcome (ubiquitty-wire-fixture--welcome)))
       ,@body)))

(ert-deftest ubiquitty-clipboard-inline-preserves-binary-mime-selector-clear-and-once-only ()
  (ubiquitty-clipboard-test--with-client
    (let* ((items (list (cons "application/octet-stream" (unibyte-string 0 255 13 10)) (cons "text/plain" "abc")))
           (bundle (ubiquitty-clipboard-test--bundle items)) (calls 0)
           (ubiquitty-sync-clipboard-write-function
            (lambda (selector received)
              (cl-incf calls)
              (should (= selector (if (= calls 1) 2 4)))
              (should (equal received (if (= calls 1) items nil)))
              (should (> ubiquitty-sync--effect-delivering-bytes 0))
              t)))
      (dotimes (_ 2) (ubiquitty-clipboard-test--receive 50 1 (ubiquitty-clipboard-test--packet 1 2 bundle)))
      (should (= calls 1))
      (should (eq ubiquitty-sync--clipboard-status 'applied))
      (ubiquitty-clipboard-test--receive 50 1 (ubiquitty-clipboard-test--packet 2 4 (unibyte-string 0)))
      (should (= calls 2))
      (should-not ubiquitty-sync--effects)
      (should (= (aref ubiquitty-sync--effect-cursor 0) 2))
      (should (= (car (ubiquitty-sync--image-owned-bytes)) 0)))))

(ert-deftest ubiquitty-clipboard-disabled-and-refused-are-not-successful-writes ()
  (dolist (configured '(nil refuse))
    (ubiquitty-clipboard-test--with-client
      (let* ((calls 0)
            (ubiquitty-sync-clipboard-write-function (and configured (lambda (_selector _items) (cl-incf calls) nil))))
        (ubiquitty-clipboard-test--receive 50 1 (ubiquitty-clipboard-test--packet 1 0 (unibyte-string 0)))
        (should (= calls (if configured 1 0)))
        (should (eq ubiquitty-sync--clipboard-status (if configured 'refused 'disabled)))
        (should (= (aref ubiquitty-sync--effect-cursor 0) 1))
        (should-not ubiquitty-sync--effects)))))

(ert-deftest ubiquitty-clipboard-recipient-refused-before-payload-decoding ()
  (dolist (role '(0 1 2 3))
    (ubiquitty-clipboard-test--with-client
      (setq ubiquitty-sync--welcome (ubiquitty-sync--read-welcome (ubiquitty-wire-fixture--welcome role)))
      (let ((decodes 0) (original (symbol-function 'ubiquitty-sync--clipboard-bundle)))
        (cl-letf (((symbol-function 'ubiquitty-sync--clipboard-bundle)
                   (lambda (&rest values) (cl-incf decodes) (apply original values))))
          (should-error (ubiquitty-clipboard-test--receive 50 1
              (ubiquitty-clipboard-test--packet 1 0 (unibyte-string 0) nil
                (if (memq role '(0 1)) (make-string 16 ?x) (make-string 16 ?p))))))
        (should (= decodes 0))
        (should (= ubiquitty-sync--clipboard-pending-bytes 0))
        (should (= (aref ubiquitty-sync--effect-cursor 1) 0))))))

(ert-deftest ubiquitty-clipboard-bulk-holds-receipt-and-charge-until-verified-handler-return ()
  (ubiquitty-clipboard-test--with-client
    (let* ((items (list (cons "application/octet-stream" (make-string 65536 42))))
           (bundle (ubiquitty-clipboard-test--bundle items)) (calls 0)
           (ubiquitty-sync-clipboard-write-function
            (lambda (selector received)
              (cl-incf calls) (should (= selector 1)) (should (equal received items))
              (should (>= (car (ubiquitty-sync--image-owned-bytes)) (* 2 (length bundle)))) t)))
      (ubiquitty-clipboard-test--receive 50 1 (ubiquitty-clipboard-test--packet 1 1 bundle 100))
      (should (= (aref ubiquitty-sync--effect-cursor 0) 0))
      (should (= (aref ubiquitty-sync--effect-cursor 1) 0))
      (ubiquitty-clipboard-test--chunk 100 0 nil (substring bundle 0 32000))
      (should (= calls 0))
      (ubiquitty-clipboard-test--chunk 100 1 t (substring bundle 32000) (secure-hash 'sha256 bundle nil nil t))
      (should (= calls 1))
      (should (= (aref ubiquitty-sync--effect-cursor 0) 1))
      (should (= (hash-table-count ubiquitty-sync--clipboard-transfers) 0))
      (should (= (car (ubiquitty-sync--image-owned-bytes)) 0)))))

(ert-deftest ubiquitty-clipboard-bulk-digest-and-unbind-refuse-stale-disclosure ()
  (dolist (mode '(hash unbind abort))
    (ubiquitty-clipboard-test--with-client
      (let* ((bundle (ubiquitty-clipboard-test--bundle (list (cons "x" "secret")))) (calls 0)
             (ubiquitty-sync-clipboard-write-function (lambda (&rest _) (cl-incf calls) t)))
        (ubiquitty-clipboard-test--receive 50 1 (ubiquitty-clipboard-test--packet 1 0 bundle 100))
        (pcase mode
          ('hash (should-error (ubiquitty-clipboard-test--chunk 100 0 t bundle (make-string 32 0)))
                 (should (= (aref ubiquitty-sync--effect-cursor 1) 0)))
          ('abort (should-error (ubiquitty-clipboard-test--receive ubiquitty-sync--kind-bulk-abort 0 (ubiquitty-sync--put-u32 100))))
          ('unbind (ubiquitty-clipboard-test--receive ubiquitty-sync--kind-pane-unbind 0 (unibyte-string 1 0))
                   (ubiquitty-clipboard-test--chunk 100 0 t bundle (secure-hash 'sha256 bundle nil nil t))
                   (should (= ubiquitty-sync--clipboard-pending-bytes 0))
                   (should (= (hash-table-count ubiquitty-sync--clipboard-transfers) 0))))
        (should (= calls 0))))))

(ert-deftest ubiquitty-clipboard-callback-unbind-retains-current-owner-only-through-return ()
  (ubiquitty-clipboard-test--with-client
    (let* ((bundle (ubiquitty-clipboard-test--bundle (list (cons "x" "secret"))))
           (ubiquitty-sync-clipboard-write-function
            (lambda (_selector items)
              (ubiquitty-clipboard-test--receive ubiquitty-sync--kind-pane-unbind 0 (unibyte-string 1 0))
              (should (equal items '(("x" . "secret"))))
              (should (> ubiquitty-sync--effect-delivering-bytes 0))
              (should (= ubiquitty-sync--clipboard-pending-bytes 0)) t)))
      (ubiquitty-clipboard-test--receive 50 1 (ubiquitty-clipboard-test--packet 1 0 bundle 100))
      (ubiquitty-clipboard-test--receive 50 1 (ubiquitty-clipboard-test--packet 2 0 bundle 101))
      (ubiquitty-clipboard-test--chunk 100 0 t bundle (secure-hash 'sha256 bundle nil nil t))
      (should (= (car (ubiquitty-sync--image-owned-bytes)) 0))
      (should-not ubiquitty-sync--effect-pane))))

(ert-deftest ubiquitty-clipboard-callback-replacement-does-not-debit-new-owner ()
  (ubiquitty-clipboard-test--with-client
    (let* ((bundle (ubiquitty-clipboard-test--bundle (list (cons "x" "secret"))))
           (next-queue (list (vector 'replacement))) (calls 0)
           (ubiquitty-sync-clipboard-write-function
            (lambda (_selector items)
              (cl-incf calls)
              (should (equal items '(("x" . "secret"))))
              (should (> ubiquitty-sync--effect-delivering-bytes 0))
              (setq ubiquitty-sync--process 'replacement-carrier)
              (cl-incf ubiquitty-sync--connection-generation)
              (setq ubiquitty-sync--effect-delivering-bytes 23
                    ubiquitty-sync--clipboard-pending-bytes 29
                    ubiquitty-sync--deferred-effect-bytes 31
                    ubiquitty-sync--deferred-effects next-queue
                    ubiquitty-sync--clipboard-status 'replacement)
              t)))
      (setq ubiquitty-sync--process 'original-carrier)
      (ubiquitty-clipboard-test--receive 50 1 (ubiquitty-clipboard-test--packet 1 0 bundle 100))
      (ubiquitty-clipboard-test--chunk 100 0 t bundle (secure-hash 'sha256 bundle nil nil t))
      (should (= calls 1))
      (should (= ubiquitty-sync--effect-delivering-bytes 23))
      (should (= ubiquitty-sync--clipboard-pending-bytes 29))
      (should (= ubiquitty-sync--deferred-effect-bytes 31))
      (should (eq ubiquitty-sync--deferred-effects next-queue))
      (should (eq ubiquitty-sync--clipboard-status 'replacement)))))

(ert-deftest ubiquitty-clipboard-admission-refuses-before-raw-allocation ()
  (dolist (mode '(capacity collision))
    (ubiquitty-clipboard-test--with-client
      (let* ((bundle (ubiquitty-clipboard-test--bundle (list (cons "x" "payload"))))
             (packet (ubiquitty-clipboard-test--packet 1 0 bundle 100))
             (allocations 0) (original (symbol-function 'make-string)))
        (when (eq mode 'collision) (setq ubiquitty-sync--pending-checkpoint '(2 . 100)))
        (cl-letf (((symbol-function 'make-string)
                   (lambda (size value &optional multibyte)
                     (when (= size (length bundle)) (cl-incf allocations))
                     (funcall original size value multibyte)))
                  ((symbol-function 'ubiquitty-sync--image-owned-bytes)
                   (lambda () (cons (if (eq mode 'capacity) (- ubiquitty-sync--retained-asset-budget (length packet)) 0) 0))))
          (should-error (ubiquitty-clipboard-test--receive 50 1 packet)))
        (should (= allocations 0))
        (should (= ubiquitty-sync--clipboard-pending-bytes 0))
        (should-not ubiquitty-sync--deferred-effects)
        (should (= (aref ubiquitty-sync--effect-cursor 1) 0))))))

(ert-deftest ubiquitty-clipboard-handler-error-fails-carrier-without-content-or-replay ()
  (ubiquitty-clipboard-test--with-client
    (let ((proc (make-pipe-process :name "ubiquitty-clipboard-fixture" :buffer (current-buffer) :noquery t))
          (ubiquitty-sync-clipboard-write-function (lambda (&rest _) (error "secret contents"))))
      (unwind-protect
          (progn
            (process-put proc 'buffer (current-buffer))
            (let* ((packet (ubiquitty-clipboard-test--packet 1 0 (unibyte-string 0)))
                   (inner (concat (unibyte-string 50 1) (ubiquitty-sync--put-varint (length packet)) packet)))
              (ubiquitty-sync--filter proc inner))
            (should-not (process-live-p proc))
            (should (equal (process-get proc 'protocol-failure) "ubiquitty-sync: local clipboard handler failed"))
            (should (eq ubiquitty-sync--clipboard-status 'refused))
            (should (= (aref ubiquitty-sync--effect-cursor 1) 1))
            (should (= (car (ubiquitty-sync--image-owned-bytes)) 0))
            (should-not ubiquitty-sync--effects))
        (when (process-live-p proc) (delete-process proc))))))

(defun ubiquitty-clipboard-test--request (id selector kind mime)
  (concat (ubiquitty-sync--put-u32 id) (unibyte-string selector kind)
          (ubiquitty-sync--put-bytes mime)))

(ert-deftest ubiquitty-clipboard-read-valid-requests-refuse-without-local-access ()
  (should (= ubiquitty-sync--kind-clipboard-request 51))
  (should (= ubiquitty-sync--kind-clipboard-data 74))
  (dolist (role '(0 1))
    (ubiquitty-clipboard-test--with-client
      (setq ubiquitty-sync--welcome (ubiquitty-sync--read-welcome (ubiquitty-wire-fixture--welcome role)))
      (ubiquitty-clipboard-test--receive ubiquitty-sync--kind-pane-bind 0 (concat (unibyte-string 2) (make-string 16 ?n)))
      (let ((sent nil))
        (cl-letf (((symbol-function 'ubiquitty-sync--send-sync)
                   (lambda (_proc kind handle body) (push (list kind handle body) sent)))
                  ((symbol-function 'gui-get-selection) (lambda (&rest _) (ert-fail "clipboard read")))
                  ((symbol-function 'current-kill) (lambda (&rest _) (ert-fail "kill-ring read"))))
          (dotimes (selector ubiquitty-sync--clipboard-buffer-count)
            (dolist (id '(1 4294967295))
              (dolist (mime '("" "text/plain" "text/\303\251"))
                (let ((request (ubiquitty-clipboard-test--request id selector (if (equal mime "") 0 1) mime)))
                  (ubiquitty-clipboard-test--receive 51 2 request)
                  (should (equal (pop sent) (list 74 2 (concat (ubiquitty-sync--put-u32 id) (unibyte-string 2)))))))))
        (should-not sent)
        (should-not ubiquitty-sync--effects)
        (should (= ubiquitty-sync--clipboard-pending-bytes 0))
        (should (= (aref ubiquitty-sync--effect-cursor 1) 0)))))))

(ert-deftest ubiquitty-clipboard-read-rejects-malformed-bounded-fields ()
  (let* ((valid (ubiquitty-clipboard-test--request 7 0 1 "text/plain"))
         (bad (list (concat valid "x")
                    (ubiquitty-clipboard-test--request 0 0 0 "")
                    (ubiquitty-clipboard-test--request 1 12 0 "")
                    (ubiquitty-clipboard-test--request 1 0 2 "")
                    (ubiquitty-clipboard-test--request 1 0 0 "text/plain")
                    (ubiquitty-clipboard-test--request 1 0 1 "")
                    (ubiquitty-clipboard-test--request 1 0 1 "text/\0plain")
                    (ubiquitty-clipboard-test--request 1 0 1 (unibyte-string 255))
                    (ubiquitty-clipboard-test--request 1 0 1 (unibyte-string 192 128))
                    (ubiquitty-clipboard-test--request 1 0 1 (unibyte-string 237 160 128))
                    (ubiquitty-clipboard-test--request 1 0 1 (unibyte-string 194))
                    (concat (ubiquitty-sync--put-u32 1) (unibyte-string 0 0 128 0))
                    (ubiquitty-clipboard-test--request 1 0 1 (make-string 65527 ?x)))))
    (dotimes (length (length valid)) (push (substring valid 0 length) bad))
    (dolist (body bad)
      (ubiquitty-clipboard-test--with-client
        (let ((replies 0))
          (cl-letf (((symbol-function 'ubiquitty-sync--send-sync) (lambda (&rest _) (cl-incf replies))))
            (should-error (ubiquitty-clipboard-test--receive 51 1 body)))
          (should (= replies 0)))))
    (should (= (length (plist-get (ubiquitty-sync--read-clipboard-request
                                   (ubiquitty-clipboard-test--request 1 0 1 (make-string 65526 ?x))) :mime)) 65526))))

(ert-deftest ubiquitty-clipboard-read-rejects-unbound-or-unprivileged-before-decode ()
  (dolist (role '(nil 0 1 2 3))
    (dolist (handle '(0 1 2 1073741824))
      (unless (and (memq role '(0 1)) (= handle 1))
        (ubiquitty-clipboard-test--with-client
          (setq ubiquitty-sync--welcome (and role (ubiquitty-sync--read-welcome (ubiquitty-wire-fixture--welcome role))))
          (let ((decodes 0) (replies 0))
            (cl-letf (((symbol-function 'ubiquitty-sync--read-clipboard-request)
                       (lambda (&rest _) (cl-incf decodes) (list :id 1)))
                      ((symbol-function 'ubiquitty-sync--send-sync) (lambda (&rest _) (cl-incf replies))))
              (should-error (ubiquitty-clipboard-test--receive 51 handle "")))
            (should (= decodes 0)) (should (= replies 0))))))))

(ert-deftest ubiquitty-clipboard-read-rejects-a-retired-binding ()
  (ubiquitty-clipboard-test--with-client
    (ubiquitty-clipboard-test--receive ubiquitty-sync--kind-pane-unbind 0 (unibyte-string 1 0))
    (let ((replies 0))
      (cl-letf (((symbol-function 'ubiquitty-sync--send-sync) (lambda (&rest _) (cl-incf replies))))
        (should-error (ubiquitty-clipboard-test--receive 51 1 (ubiquitty-clipboard-test--request 1 0 0 ""))))
      (should (= replies 0)))))

(ert-run-tests-batch-and-exit)
