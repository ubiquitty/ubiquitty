<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The entitlements a team-signed Mac app carries. The sealed resume record
     keeps its key in the data protection keychain, which macOS opens only to
     an app whose signature names an application identifier and a keychain
     access group; both are restricted, so Scripts/build-macos.sh applies this
     file only with a provisioning profile that authorizes them, and only for a
     team identity. __TEAM__ and __BUNDLE__ are replaced there with the signing
     team and the bundle's identifier; every flavour shares one access group. -->
<plist version="1.0">
<dict>
    <key>com.apple.application-identifier</key>
    <string>__TEAM__.__BUNDLE__</string>
    <key>com.apple.developer.team-identifier</key>
    <string>__TEAM__</string>
    <key>keychain-access-groups</key>
    <array>
        <string>__TEAM__.org.ubiquitty.Ubiquitty</string>
    </array>
</dict>
</plist>
