// The Swift interop surfaces that are this shell's alone.
//
// Separate from Source/Platform/Apple/module.modulemap because that one is
// shared with the phone: these two name this app's own bridge headers, and a
// shared map naming them made the phone compile against Source/Platform/macOS/App.
//
// The virtual-key table is NOT here, though it is equally this shell's: it
// reaches a Core header the shared map owns, and a header named by two maps is
// parsed into both and defined twice.

// What this shell's Swift needs from C++ that Core's own module does not
// carry: the application delegate's platform context, the ssh and mosh
// wrappers and the settings edits that walk C++ structures; the Settings
// window's theme and blur facts; and the OSC 52 read confirmation's resolver. A preference itself is read and written through
// Core's by-key surface, not through anything here.
module UbiquittyAppBridge {
    header "App/ApplicationBridge.h"
    header "App/UBClipboardReadInterop.h"
    header "App/UBSettingsInterop.h"
    requires cplusplus
    export *
}

// The descriptor handoff "Share This Window" performs: the one step of a share
// that crosses a native handle, so it lives behind the POSIX seam rather than
// in Core, and this shell names it by the address a session's share takes.
module UbiquittySessionHandoff {
    header "../POSIX/SessionHandoff.h"
    requires cplusplus
    export *
}

// Bringing this Mac's host up to the build the app bundles: the file and
// socket work behind the POSIX seam, which the app runs at launch and when a
// person asks to update This Mac's host.
module UbiquittyLocalHostInstall {
    header "../POSIX/LocalHostInstall.h"
    requires cplusplus
    export *
}

// A remote window's sealed resume owner: the record of one window identity,
// restored before any I/O and handed to the window's session.
module UbiquittyRemoteResume {
    header "RemoteResumeBridge.h"
    export *
}
