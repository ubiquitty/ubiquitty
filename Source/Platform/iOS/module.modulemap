// The shell imports the session seam as a module rather than through a bridging
// header: there is no Objective-C in this frontend to hang one off, and a
// module is what a plain C header wants anyway.
module UbiquittyIOSBridge {
    header "SessionBridge.h"
    header "Clipboard.h"
    // The pane clients the shell registers at launch.
    header "SessionClients.h"
    // PAL, so a smoke can drive the clipboard the way the terminal does rather
    // than calling the shell's own writer and proving nothing.
    header "../../PAL/PAL.h"
    export *
}
