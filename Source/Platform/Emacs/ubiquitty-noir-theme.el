      ;; (268 degrees, chroma 0.012), by the lightness step named in each.
      (surface-low    "#1c1e24")  ; L+0.03, the current line
      (band           "#23252b")  ; L+0.06, the app's tab-strip band
      (surface-high   "#31343a")  ; L+0.12, hover and pressed states
      ;; Tinted surfaces: an accent's hue at the band's lightness range.
      (blue-tint      "#2a3a50")  ; L 0.34, region
      (blue-tint-deep "#2e4463")  ; L 0.38, matches and paren pairs
      (red-tint       "#3f2829")  ; L 0.30, removed lines
      (red-tint-deep  "#4e2f31")  ; L 0.34, refined removals, failures
      (green-tint     "#243424")  ; L 0.30, added lines
