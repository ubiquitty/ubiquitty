      (black          "#2e323b")
      (red            "#dd717a")
      (green          "#98c896")
      (yellow         "#e3be7c")
      (blue           "#72a3e8")
      (magenta        "#c189d9")
      (cyan           "#66c0c8")
      (white          "#c8ccd4")
      (bright-black   "#5a606e")
      (bright-red     "#ea8088")
      (bright-green   "#a9d89f")
      (bright-yellow  "#efce8e")
      (bright-blue    "#8ab5ee")
      (bright-magenta "#d09fe5")
      (bright-cyan    "#7ccfd6")
      (bright-white   "#eaedf2")
