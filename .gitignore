build/

# macOS swap / document-recovery files (.!NNNNN! pattern)
.!*!
# Every out-of-tree build/scratch dir. Named ones kept reappearing untracked
# (BuildBench, BuildPGOTrain, …); the pattern covers the next one.
Build*/
*.o
*.obj
*.bak
*.zip
.DS_Store
# Erlang VM crash dumps — never a source artifact, can carry process memory/env.
*.dump
erl_crash.dump
*.d
*.dia
*.swiftconstvalues

# Editor / IDE
.vscode/
.idea/
*.swp
\#*\#

# clangd index + compile DB (per-checkout, regenerated by the build)
.cache/
compile_commands.json

# Python
__pycache__/
*.pyc
# Emacs byte-compilation writes this beside the source, so any check of
# whether ubiquitty-sync.el still compiles leaves one behind.
*.elc

Source/build_id.h

# Local Claude Code metadata
.claude/

# Support/Host/ build artifacts (Mach-O + bundle + dSYM + user prefs + intermediate PPMs)
Support/Host/Ubiquitty Preferences
Support/Host/preview
Support/Host/viewer
Support/Host/term
Support/Host/term.app/
Support/Host/chrome_dump_*.ppm

# Linux AppImage build artifacts (built by Scripts/package-linux-appimage.sh)
*.AppImage
*.AppImage.zsync
BuildBench/
BuildCellArms/
bench-results.json
render-profile-results.json

build/linux-ccache/

# Swift PGO trains per machine: front-end instrumentation keys functions by
# absolute compile path, so the artifact cannot be shared (Scripts/pgo-train-swift.sh).
Support/pgo/swift-renderkit.profdata
Support/pgo/swift-renderkit.trained-at

# Runtime grant/consent-store files the agent or host daemon writes to its CWD
# (mode 0600, zero-byte until populated). Never tracked.
capability_grants
consent

# SwiftPM build products under the UbiquittySSH package. Its Package.resolved
# is tracked: it pins every package the iOS app links, which the third-party
# inventory names version by version.
Source/Platform/Apple/SSH/.build/
Source/Platform/Apple/SSH/.swiftpm/

# Per-developer Xcode state — window layout, breakpoints, the scheme and
# device each person last selected. The workspaces themselves are tracked,
# because they are what a reader opens; this is what Xcode writes beside one
# while it is open, and it is different for everyone.
Ubiquitty.xcworkspace/xcuserdata/
UbiquittyIOS.xcworkspace/xcuserdata/

# Swift incremental-compile dependency files, when a build drops them in the
# checkout instead of its build directory. Untracked and unignored, 49 of them
# accumulated in one working copy and buried `git status`; each is named after a
# Source/UbiquittyRenderKit source, so the producer is one of the generated
# Xcode projects rather than the Ninja build, which never leaves any. Which
# project, and why the driver falls back to the working directory when its
# output file map names an absolute path, is not established — this keeps them
# out of `git status` and does not pretend to be the fix.
*.swiftdeps
# The snapshot runner's temporaries, kept under the tree so the Linux arm's
# container can reach them through its bind mount.
Tests/Snapshots/.ubiquitty-configs-*/
Tests/Snapshots/.ubiquitty-regressions-*/
Tests/Snapshots/.shim-snapshot-*
Tests/Snapshots/.shim-fontconfig-*
Tests/Snapshots/tmp*/
Tests/Snapshots/tmp*
