root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.sh]
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.{json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.r]
# Rez resource source: hand-formatted, do not reflow.
trim_trailing_whitespace = false
